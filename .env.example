# AICTE Institution Conflict Radar - Environment Configuration

# Service & Mode
PROJECT_NAME="SIH26264 Institution Conflict Radar"
ENVIRONMENT=development
ORGANIZATION_TIMEZONE=Asia/Kolkata

# Database (Default: SQLite for zero-setup demo; set to PostgreSQL for production)
DATABASE_URL=sqlite:///./radar.db
# DATABASE_URL=postgresql://radar_admin:secure_dev_password_123@localhost:5432/aicte_radar

# JWT Security
SECRET_KEY=sih26264-institution-conflict-radar-master-secret-key-development-mode
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Conflict Radar Weights (Formula: S = I + N + C + D + W)
RADAR_WEIGHT_EXACT_ID=45
RADAR_WEIGHT_NAME_ADDR=15
RADAR_WEIGHT_CATEGORY=15
RADAR_WEIGHT_DESCRIPTION=15
RADAR_WEIGHT_CROSS_BUREAU=10
RADAR_CANDIDATE_THRESHOLD=40
